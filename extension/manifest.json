{
  "manifest_version": 3,
  "name": "MBA Recruiting Tool \u2013 Save LinkedIn Contact",
  "version": "0.4.1",
  "description": "Save the LinkedIn profile you're viewing to your MBA Recruiting Tool contacts.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to MBA Recruiting Tool",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://mba-recruiting-tool.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
